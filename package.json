{
    "name": "anish.land",
    "version": "0.0.1",
    "dependencies": {
        "@astrojs/cloudflare": "^12.6.0",
        "astro": "^5.12.5",
        "drizzle-orm": "^0.44.4"
    },
    "scripts": {
        "dev": "astro dev",
        "dev:wrangler": "astro build && wrangler dev --config ./wrangler.jsonc",
        "build": "COMMIT_HASH=$(git rev-parse HEAD) BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) astro build",
        "preview": "astro preview",
        "astro": "astro",
        "generate-types": "wrangler types",
        "type-check": "generate-types && tsc",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:migrate": "wrangler d1 migrations apply notes-db --remote",
        "db:studio": "deno run -A --env-file=.env npm:drizzle-kit studio --config drizzle.config.ts"
    },
    "type": "module",
    "devDependencies": {
        "@types/node": "^24.19.2",
        "drizzle-kit": "^0.31.4",
        "typescript": "^6",
        "wrangler": "^4.158.0"
    }
}
